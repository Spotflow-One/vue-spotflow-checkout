{
  "name": "@spot-flow/vue-spotflow-checkout",
  "version": "0.1.5",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "build:index": "vite build",
    "build:plugin": "vite build --config vite.config.plugin.ts",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build": "npm run clean && npm run build:index && npm run build:plugin && npm run build:types",
    "build:analyze": "npm run build && npm run analyze",
    "analyze": "npx vite-bundle-analyzer dist/index.js",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "format": "prettier --write lib/ examples/ *.md",
    "format:check": "prettier --check lib/ examples/ *.md",
    "test": "echo \"No tests specified yet\" && exit 0",
    "test:types": "npm run type-check",
    "prepublishOnly": "npm run build && npm run test:types",
    "release": "npm run build && npm publish",
    "release:dry": "npm run build && npm publish --dry-run",
    "size": "size-limit",
    "docs:dev": "echo \"Documentation server not implemented yet\"",
    "validate": "npm run lint:check && npm run type-check && npm run format:check"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "vue": "^3.4.29"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.8.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.14.5",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "npm-run-all2": "^6.2.0",
    "nuxt": "^4.1.2",
    "prettier": "^3.2.5",
    "typescript": "~5.4.0",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^4.0.0",
    "vue-tsc": "^2.0.21",
    "rimraf": "^5.0.5",
    "vite-bundle-analyzer": "^0.7.0",
    "size-limit": "^11.0.1",
    "@size-limit/preset-small-lib": "^11.0.1"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "50 KB",
      "gzip": false
    },
    {
      "path": "dist/index.js",
      "limit": "15 KB",
      "gzip": true
    }
  ],
  "license": "ISC",
  "author": {
    "name": "Spotflow",
    "email": "devrel@spotflow.one",
    "url": "https://spotflow.one"
  },
  "contributors": [
    {
      "name": "Spotflow DevRel Team",
      "email": "devrel@spotflow.one"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spotflow-One/vue-spotflow-checkout.git",
    "directory": "."
  },
  "homepage": "https://github.com/Spotflow-One/vue-spotflow-checkout#readme",
  "bugs": {
    "url": "https://github.com/Spotflow-One/vue-spotflow-checkout/issues",
    "email": "devrel@spotflow.one"
  },
  "funding": {
    "type": "company",
    "url": "https://spotflow.one"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "vuejs",
    "spotflow",
    "checkout",
    "payment",
    "payment-gateway",
    "fintech",
    "nuxt",
    "nuxt3",
    "typescript",
    "e-commerce",
    "subscription",
    "africa",
    "nigeria",
    "ghana",
    "kenya",
    "south-africa",
    "merchant-of-record",
    "accessibility",
    "a11y"
  ],
  "packageManager": "yarn@4.4.0+sha512.91d93b445d9284e7ed52931369bc89a663414e5582d00eea45c67ddc459a2582919eece27c412d6ffd1bd0793ff35399381cb229326b961798ce4f4cc60ddfdb"
}
